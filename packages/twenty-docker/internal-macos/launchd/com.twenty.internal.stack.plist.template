<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.twenty.internal.stack</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>__STACK_DIRECTORY__/scripts/start.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>__STACK_DIRECTORY__/stack.log</string>
    <key>StandardErrorPath</key>
    <string>__STACK_DIRECTORY__/stack-error.log</string>
  </dict>
</plist>
